# Скопируйте этот файл в .env и заполните. Файл .env НЕ загружается в GitHub.

# --- YandexGPT (Yandex AI Studio) ---
# Без этих двух строк бот работает в демо-режиме (без нейросети).
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Модель: yandexgpt-lite/latest (быстрее и дешевле) или yandexgpt/latest
YANDEX_MODEL=yandexgpt-lite/latest

# --- Кризисная карточка ---
# Проверенный номер телефона доверия для вашего региона (112 показывается всегда)
HELPLINE_PHONE=

# --- Демо-клиника ---
DEMO_CLINIC_KEY=demo
DEMO_ADMIN_TOKEN=demo-admin

# --- Ограничения ---
MAX_MESSAGE_LENGTH=1000
MAX_MESSAGES_PER_MINUTE=10
